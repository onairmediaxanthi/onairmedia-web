APP_NAME="On Air Media Group"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://new.onairmedia.gr
APP_TIMEZONE=Europe/Athens
APP_LOCALE=el
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=el_GR

# Κλειδαριά προεπισκόπησης: όσο είναι συμπληρωμένο, το site ζητά αυτόν τον κωδικό
PREVIEW_PASSWORD=

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=s657.srvx.ws
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@onairmedia.gr
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@onairmedia.gr
MAIL_FROM_NAME="${APP_NAME}"
